{
  "exclude": [
    "prisma.config.ts",
    "node_modules",
    "dist"
  ],
  "include": [
    "src/**/*.ts",
    "generated/prisma8/**/*.d.ts"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@prisma": ["generated/prisma8"]
    },
    "types": ["node"],
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}